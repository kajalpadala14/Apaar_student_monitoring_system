# ====================================================================
# APAAR Student Monitoring Dashboard - Environment Configuration (.env.example)
# ====================================================================

# 1. Google Apps Script Web App URL (For live Google Sheet sync)
# Deploy your Google Apps Script as a Web App (Access: Anyone) and paste the URL here.
# Example: https://script.google.com/macros/s/AKfycbx.../exec
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_YOUR_SCRIPT_ID_HERE/exec

# 2. Administrative Defaults (used if sheet headers or rows don't specify them)
VITE_DEFAULT_DISTRICT_NAME=Dantewada
VITE_DEFAULT_DISTRICT_CODE=2216
VITE_DEFAULT_STATE_NAME=Chhattisgarh
VITE_DEFAULT_DEPARTMENT=School Education Department
VITE_APP_TITLE="APAAR Student Monitoring Dashboard"
